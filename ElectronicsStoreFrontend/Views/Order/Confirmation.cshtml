@model ElectronicsStoreFrontend.Models.OrderConfirmationDto

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="text-center">
    <h2 class="text-success">🎉 Thank you for your order!</h2>
    <p>Your order has been placed successfully.</p>

    <div class="card mt-4 mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <p><strong>Order ID:</strong> @Model.OrderId</p>
            <p><strong>Total:</strong> $@Model.TotalAmount</p>
            <p><strong>Date:</strong> @Model.CreatedAt.ToString("f")</p>
        </div>
    </div>

    <a class="btn btn-primary mt-3" asp-controller="Product" asp-action="Index">Continue Shopping</a>
</div>
